\subsection{Partial states}
\begin{figure}
<<state10>>=
astate10 <- c(outer(c("CU", "MCI", "dementia"), c("low", "mod", "high"),
                   paste, sep='-'), "death")
alias10 <- data.frame(state=astate10, C= c(rep(1:3, 3), 0),
                      A= c(rep(1:3, each=3), 0))
alt10 <-  alias10
alt10$state <- c(outer(c("CU", "MCI", "dementia"), c("low", "mod", "high"),
                   paste, sep='\n'), "death")
amat10 <- qplus(alias10, death="death")

amat10x <- qplus(alt10, death="death")
indx <- c(1,4,7,2,5,8,3,6,9,10)
statefig(rbind(3,3,3,1), amat10x[indx, indx], 
         alty=rep(1:0, c(sum(amat10x[,-10]), 9)))
@
 \caption{State space with transitions for both amyloid and cognition.
   Arrows to death are suppressed for clarity.}
 \label{state10}
\end{figure}


